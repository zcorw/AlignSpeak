# Required secrets
JWT_SECRET=replace-with-a-long-random-secret
POSTGRES_PASSWORD=replace-with-a-strong-password
DATABASE_URL=postgresql+psycopg://alignspeak:replace-with-a-strong-password@db:5432/alignspeak
OPENAI_API_KEY=replace-with-openai-api-key
BOOTSTRAP_ADMIN_KEY=replace_with_bootstrap_admin_key

# Optional application settings
OCR_PROVIDER=openai
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_OCR_MODEL=gpt-4.1-mini
OPENAI_OCR_TIMEOUT_SECONDS=45
STT_PROVIDER=openai
OPENAI_STT_MODEL=gpt-4o-mini-transcribe
OPENAI_STT_TIMEOUT_SECONDS=120
OPENAI_MONTHLY_BUDGET_USD=10
OPENAI_BUDGET_ALERT_THRESHOLD_USD=8
OPENAI_BUDGET_HARD_STOP_USD=9.5
ACCESS_TOKEN_EXPIRE_SECONDS=43200
ARTICLE_TTS_WORKER_LEASE_SECONDS=120
ARTICLE_TTS_JOB_MAX_ATTEMPTS=3
ARTICLE_TTS_WORKER_POLL_SECONDS=2
ARTICLE_TTS_CLEANUP_INTERVAL_SECONDS=3600
ARTICLE_TTS_TEMP_FILE_TTL_SECONDS=86400
ARTICLE_TTS_ASSET_RETENTION_SECONDS=604800
ARTICLE_TTS_CLEANUP_BATCH_SIZE=100
ARTICLE_TTS_STORAGE_MAX_BYTES=10737418240
ARTICLE_TTS_WORKER_HEALTH_FILE=/tmp/article-tts-worker.heartbeat
ARTICLE_TTS_WORKER_HEALTH_STALE_SECONDS=90

# Optional bind ports for host nginx upstreams
WEB_PORT=8080
API_PORT=8000
DB_ADMIN_PORT=18080
DB_ADMIN_ENABLED=false
